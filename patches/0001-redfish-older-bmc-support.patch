+# NOTE(relaxed): HPE iLO 4 (and some iLO 5 firmware) do not implement the
+# standard #VirtualMedia.InsertMedia action at all. They advertise an OEM
+# action instead, under Oem/Hp or Oem/Hpe. The stock code treats a missing
+# standard action as "this slot cannot do remote media" and skips the device,
+# which on those BMCs skips every device and leaves nothing to boot.
+#
+# These helpers are reached ONLY when the standard action is absent, so they
+# cannot change behaviour on a BMC that implements it.
+_OEM_VENDORS = ('Hp', 'Hpe')
+
+
+def _oem_vmedia_action(v_media, verb):
+    """Find a vendor OEM virtual media action on a device.
+
+    :param v_media: a sushy VirtualMedia resource.
+    :param verb: either 'Insert' or 'Eject'.
+    :returns: a (vendor, target_uri) tuple, or (None, None) if not found.
+    """
+    oem = v_media.json.get('Oem') or {}
+    for vendor in _OEM_VENDORS:
+        actions = (oem.get(vendor) or {}).get('Actions') or {}
+        key = '#%siLOVirtualMedia.%sVirtualMedia' % (vendor, verb)
+        target = (actions.get(key) or {}).get('target')
+        if target:
+            return vendor, target
+    return None, None
 
 
+def _oem_insert_vmedia(task, v_media, boot_url):
+    """Insert virtual media using a vendor OEM action.
+
+    :param task: a TaskManager instance.
+    :param v_media: a sushy VirtualMedia resource.
+    :param boot_url: URL of the image to insert.
+    :returns: True if an OEM action was found and accepted, else False.
+    """
+    if not CONF.redfish.enable_oem_vmedia_fallback:
+        return False
+
+    vendor, target = _oem_vmedia_action(v_media, 'Insert')
+    if not target:
+        return False
+
+    # BootOnNextServerReset is the iLO equivalent of a one-time boot override.
+    # It is set here because a BMC lacking the standard InsertMedia action is
+    # also unlikely to honour the standard Boot override, and inserting media
+    # the machine will not boot is not useful.
+    payload = {'Image': boot_url,
+               'Oem': {vendor: {'BootOnNextServerReset': True}}}
+    try:
+        v_media._conn.post(target, data=payload)
+    except sushy.exceptions.SushyError as exc:
+        LOG.warning('OEM virtual media insert via %(vendor)s failed for node '
+                    '%(node)s: %(exc)s',
+                    {'vendor': vendor, 'node': task.node.uuid, 'exc': exc})
+        return False
+
+    LOG.info('Inserted boot media into %(slot)s on node %(node)s using the '
+             '%(vendor)s OEM action, because this BMC does not implement the '
+             'standard InsertMedia action.',
+             {'slot': v_media.identity, 'node': task.node.uuid,
+              'vendor': vendor})
+    return True
+
+
+def _oem_eject_vmedia(task, v_media):
+    """Eject virtual media using a vendor OEM action.
+
+    :param task: a TaskManager instance.
+    :param v_media: a sushy VirtualMedia resource.
+    :returns: True if an OEM action was found and accepted, else False.
+    """
+    if not CONF.redfish.enable_oem_vmedia_fallback:
+        return False
+
+    vendor, target = _oem_vmedia_action(v_media, 'Eject')
+    if not target:
+        return False
+
+    try:
+        v_media._conn.post(target, data={})
+    except sushy.exceptions.SushyError as exc:
+        LOG.warning('OEM virtual media eject via %(vendor)s failed for node '
+                    '%(node)s: %(exc)s',
+                    {'vendor': vendor, 'node': task.node.uuid, 'exc': exc})
+        return False
+
+    LOG.info('Ejected boot media from %(slot)s on node %(node)s using the '
+             '%(vendor)s OEM action.',
+             {'slot': v_media.identity, 'node': task.node.uuid,
+              'vendor': vendor})
+    return True
+
+
